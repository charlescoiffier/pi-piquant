# API π-piquant (PNG à la demande) : serveur Node sans framework, port 8081
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:api

FROM node:22-alpine
# Polices : le canvas Node n'en embarque aucune ; Liberation couvre Helvetica/Arial et le « π » de la légende
RUN apk add --no-cache fontconfig ttf-liberation
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist-api ./dist-api
USER node
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -q -O /dev/null http://127.0.0.1:8081/api/health || exit 1
CMD ["node", "dist-api/server.js"]
